# =================================================================
# Necom Platform Configuration
# =================================================================

# Database Configuration (MySQL 8.0)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=necom
MYSQL_USER=necom
MYSQL_PASSWORD=necom
MYSQL_PORT=3306

# Backend Configuration (Spring Boot)
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=ci
SPRING_SQL_INIT_MODE=never

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-must-be-long-and-secure-for-hs512
JWT_EXPIRATION_MS=10080000
JWT_REFRESH_EXPIRATION_MS=86400000

# Frontend Configuration (React / Nginx)
CLIENT_PORT=80

# Mail Configuration (Optional - for order confirmations)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Payment Gateways (Optional)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# Shipping Services (Optional - Giao Hang Nhanh)
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-ghn-shop-id
GHN_API_PATH=https://dev-online-gateway.ghn.vn/shiip/public-api/v2

# Chatbot CSKH – API tương thích OpenAI (để trống CHATBOT_API_KEY để tắt bot)
# Trong Docker trên VPS có thể trỏ tới dịch vụ trên host: http://host.docker.internal:<port>/v1
CHATBOT_ENABLED=true
CHATBOT_BASE_URL=https://your-ai-endpoint/v1
CHATBOT_API_KEY=your-api-key
CHATBOT_MODEL=your-model
